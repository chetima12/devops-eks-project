pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(
            logRotator(numToKeepStr: '10')
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REPOSITORY = 'nodejs-eks-app'
        EKS_CLUSTER = 'nodejs-eks-cluster'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Environment') {
            steps {
                sh '''
                    echo "================================="
                    echo "Environment"
                    echo "================================="

                    node --version
                    npm --version
                    docker --version
                    aws --version
                    kubectl version --client
                    helm version
                    trivy --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('nodejs-eks-app') {
                    sh '''
                        echo "Checking Node.js dependencies..."

                        node --version
                        npm --version

                        if [ -d "node_modules" ]; then
                            echo "node_modules already exists. Skipping npm ci..."
                        else
                            echo "Installing Node.js dependencies..."
                            npm ci
                        fi
                    '''
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('nodejs-eks-app') {
                    sh '''
                        echo "Running unit tests..."

                        npm test
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: 'SonarScanner',
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv('SonarQube') {
                        withEnv(["PATH+SONAR=${scannerHome}/bin"]) {
                            sh '''
                                echo "Running SonarQube analysis..."

                                which sonar-scanner
                                sonar-scanner --version
                                sonar-scanner
                            '''
                        }
                    }
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."

                    trivy fs \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        --skip-dirs "nodejs-eks-app/node_modules" \
                        ./nodejs-eks-app
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "Building Docker image..."

                    docker build \
                        -t nodejs-eks-app:${IMAGE_TAG} \
                        ./nodejs-eks-app
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    echo "Running Trivy image scan..."

                    trivy image \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        --pkg-types os,library \
                        nodejs-eks-app:${IMAGE_TAG}
                '''
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {
                    sh '''
                        echo "Logging into Amazon ECR..."

                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                            --query Account \
                            --output text)

                        aws ecr get-login-password \
                            --region ${AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin \
                            ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {
                    sh '''
                        echo "Pushing Docker image to ECR..."

                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                            --query Account \
                            --output text)

                        ECR_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}

                        docker tag \
                            nodejs-eks-app:${IMAGE_TAG} \
                            ${ECR_URI}:${IMAGE_TAG}

                        docker push \
                            ${ECR_URI}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {
                    sh '''
                        echo "Updating EKS kubeconfig..."

                        aws eks update-kubeconfig \
                            --region ${AWS_REGION} \
                            --name ${EKS_CLUSTER}

                        echo "Deploying application with Helm..."

                        helm upgrade --install nodejs-app \
                            helm/nodejs-app \
                            --namespace nodejs-app \
                            --create-namespace \
                            --set image.tag=${IMAGE_TAG} \
                            --force-conflicts
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {
                    sh '''
                        echo "Verifying Kubernetes deployment..."

                        kubectl rollout status \
                            deployment/nodejs-app-nodejs-app \
                            -n nodejs-app \
                            --timeout=180s

                        echo "Pods:"
                        kubectl get pods \
                            -n nodejs-app \
                            -o wide

                        echo "Services:"
                        kubectl get svc \
                            -n nodejs-app

                        echo "Ingress:"
                        kubectl get ingress \
                            -n nodejs-app
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '================================='
            echo 'CI/CD PIPELINE SUCCESSFUL'
            echo '================================='
        }

        failure {
            echo '================================='
            echo 'CI/CD PIPELINE FAILED'
            echo '================================='
        }

        always {
            echo "Build number: ${BUILD_NUMBER}"
        }
    }
}