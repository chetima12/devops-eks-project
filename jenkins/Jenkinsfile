pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION     = 'us-east-1'
        EKS_CLUSTER    = 'nodejs-eks-cluster'
        ECR_REPOSITORY = 'nodejs-eks-app'
        IMAGE_NAME     = 'nodejs-eks-app'
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    git rev-parse --short HEAD
                    git branch --show-current || true
                '''
            }
        }

        stage('Environment Check') {
            steps {
                sh '''
                    node --version
                    npm --version
                    docker --version
                    aws --version
                    kubectl version --client
                    helm version
                    trivy --version
                '''
            }
        }

        stage('Install & Test') {
            steps {
                dir('nodejs-eks-app') {
                    sh '''
                        npm ci
                        npm test
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool name: 'SonarScanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    withSonarQubeEnv('SonarQube') {
                        withEnv(["PATH+SONAR=${scannerHome}/bin"]) {
                            sh 'sonar-scanner'
                        }
                    }
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    trivy fs \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        --skip-dirs "nodejs-eks-app/node_modules" \
                        ./nodejs-eks-app
                '''
            }
        }

        stage('Docker Build & Scan') {
            steps {
                sh '''
                    docker build --pull -t ${IMAGE_NAME}:${IMAGE_TAG} ./nodejs-eks-app
                    trivy image --exit-code 1 --severity HIGH,CRITICAL ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('AWS Deployment & Release') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    sh '''
                        set -e
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                        ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                        ECR_URI=${ECR_REGISTRY}/${ECR_REPOSITORY}

                        # ECR Login & Push
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_URI}:${IMAGE_TAG}
                        docker push ${ECR_URI}:${IMAGE_TAG}

                        # Helm Deploy to EKS
                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER}
                        helm upgrade --install nodejs-app helm/nodejs-app \
                            --namespace nodejs-app \
                            --create-namespace \
                            --set image.repository=${ECR_URI} \
                            --set image.tag=${IMAGE_TAG}

                        # Verification
                        kubectl rollout status deployment/nodejs-app-nodejs-app -n nodejs-app --timeout=180s
                        kubectl get pods -n nodejs-app
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text 2>/dev/null || true)
                ECR_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}

                docker image rm ${IMAGE_NAME}:${IMAGE_TAG} 2>/dev/null || true
                docker image rm ${ECR_URI}:${IMAGE_TAG} 2>/dev/null || true
            '''
            cleanWs()
        }
    }
}